@page "/notfound"
@layout Layout.AuthLayout
@inject NavigationManager Navigation

<MudContainer Class="d-flex flex-column justify-center align-center" Style="min-height: 80vh;">
    <MudIcon Icon="@Icons.Material.Filled.QuestionMark" Size="Size.Large" Color="Color.Default" />
    <MudText Typo="Typo.h3" Class="mt-4">404</MudText>
    <MudText Typo="Typo.h6" Class="mt-2">Page not found</MudText>
    <MudText Typo="Typo.body2" Color="Color.Default" Class="mt-2">
        The page you are looking for does not exist.
    </MudText>
    <MudButton Href="/projects" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">
        Go to Projects
    </MudButton>
</MudContainer>
