@page "/invite"
@rendermode InteractiveServer
@inject InviteService InviteService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Invite Technician - HelpDesk</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-4">Invite Technician</MudText>

    <MudPaper Class="pa-6">
        <MudText Typo="Typo.body1" Class="mb-4">
            Generate an invite link to register a new technician.
        </MudText>

        <MudStack AlignItems="AlignItems.Stretch">
            <MudNumericField @bind-Value="_validDays" Label="Valid for (days)" Min="1" Max="30"
                             Class="mb-2" />

            <MudButton OnClick="GenerateAsync" Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="_loading" FullWidth="true">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Generate Invite Link
            </MudButton>
        </MudStack>

        @if (_inviteUrl is not null)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Invite Link</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudTextField Value="_inviteUrl" ReadOnly="true" Variant="Variant.Outlined"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                              OnAdornmentClick="CopyToClipboard" Class="flex-grow-1" />
                <MudTooltip Text="Copy to clipboard">
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary"
                                   OnClick="CopyToClipboard" />
                </MudTooltip>
            </MudStack>
            <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-2">
                Expires: @_expiresAt?.ToString("MMM dd, yyyy HH:mm")
            </MudText>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
        }
    </MudPaper>
</MudContainer>

@code {
    private int _validDays = 7;
    private bool _loading;
    private string? _inviteUrl;
    private DateTime? _expiresAt;
    private string? _error;

    private async Task GenerateAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var invite = await InviteService.InviteAsync(_validDays);
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            _inviteUrl = $"{baseUrl}/register?code={invite.Code}";
            _expiresAt = invite.ExpiresAt;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CopyToClipboard()
    {
        if (_inviteUrl is not null)
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _inviteUrl);
            Snackbar.Add("Copied to clipboard", Severity.Success);
        }
    }

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
}
