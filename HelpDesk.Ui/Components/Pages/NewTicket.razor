@page "/tickets/new"
@rendermode InteractiveServer
@inject TicketService TicketService
@inject AttachmentService AttachmentService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>New Ticket - HelpDesk</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/tickets" />
        <MudText Typo="Typo.h4">Create Ticket</MudText>
    </MudStack>

    <MudPaper Class="pa-6">
        <MudTextField @bind-Value="_title" Label="Title" Required="true" MaxLength="200"
                      Class="mb-4" FullWidth="true" />

        <MudTextField @bind-Value="_description" Label="Description" Lines="5" MaxLength="2000"
                      Class="mb-4" FullWidth="true" />

        <MudFileUpload @bind-Files="Files" Multiple="true"
                       Accept=".jpg,.jpeg,.png,.gif,.webp,.log,.pdf,.txt,.csv,.doc,.docx,.xls,.xlsx,
                       .ppt,.pptx" Class="mb-4">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile">
                    Attach Files
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        @if (_files is { Count: > 0 })
        {
            <MudText Typo="Typo.body2" Class="mb-2">@_files.Count file(s) selected</MudText>

            <MudGrid Class="mb-4">
                @foreach (var file in _files)
                {
                    <MudItem xs="6" sm="4" md="3">
                        <MudPaper Class="pa-1 relative">
                            @if (_previewUrls.TryGetValue(file, out var dataUrl) && dataUrl is not null)
                            {
                                <img src="@dataUrl"
                                     alt="@file.Name"
                                     style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; display: block;" />
                            }
                            else
                            {
                                <div style="width: 100%; aspect-ratio: 1; align-items: center; justify-content: center; flex-direction: column; background: var(--mud-palette-surface); border-radius: 8px; padding: 8px; display: flex;">
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Large" Color="Color.Default" />
                                    <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1"
                                             Style="word-break: break-all; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                        @file.Name
                                    </MudText>
                                </div>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                           Color="Color.Error"
                                           Style="position: absolute; top: 4px; right: 4px;"
                                           OnClick="() => RemoveFile(file)" />
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudButton Href="/tickets" Variant="Variant.Outlined" Class="mr-2">Cancel</MudButton>
            <MudButton OnClick="CreateAsync" Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="_loading || string.IsNullOrWhiteSpace(_title)">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Create
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string _title = "";
    private string? _description;
    private bool _loading;
    private IReadOnlyList<IBrowserFile>? _files;
    private Dictionary<IBrowserFile, string?> _previewUrls = new();

    private static readonly string[] ImageTypes = { "image/jpeg", "image/png", "image/gif", "image/webp" };

    private IReadOnlyList<IBrowserFile>? Files
    {
        get => _files;
        set
        {
            _files = value;
            _ = LoadPreviews();
        }
    }

    private async Task LoadPreviews()
    {
        if (_files is null) return;

        var current = new HashSet<IBrowserFile>(_files);

        foreach (var file in current)
        {
            if (_previewUrls.ContainsKey(file)) continue;

            if (file.ContentType is not null && ImageTypes.Contains(file.ContentType))
            {
                try
                {
                    using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                    using var ms = new MemoryStream();
                    await stream.CopyToAsync(ms);
                    _previewUrls[file] = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
                }
                catch
                {
                    _previewUrls[file] = null;
                }
            }
            else
            {
                _previewUrls[file] = null;
            }
        }

        foreach (var key in _previewUrls.Keys.ToList())
        {
            if (!current.Contains(key))
                _previewUrls.Remove(key);
        }

        StateHasChanged();
    }

    private void RemoveFile(IBrowserFile file)
    {
        Files = _files?.Where(f => f != file).ToList();
    }

    private async Task CreateAsync()
    {
        _loading = true;
        try
        {
            var ticket = await TicketService.CreateAsync(new CreateTicketRequest
            {
                Title = _title,
                Description = _description
            });

            if (_files is { Count: > 0 })
            {
                foreach (var file in _files)
                {
                    try
                    {
                        await AttachmentService.UploadAsync(ticket.Id, file);
                    }
                    catch { }
                }
            }

            Navigation.NavigateTo($"/tickets/{ticket.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
