@page "/tags"
@rendermode InteractiveServer
@inject TagService TagService
@inject ISnackbar Snackbar

<PageTitle>Tags - HelpDesk</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudText Typo="Typo.h4" Class="mb-4">Tag Management</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="_newTagName" Label="Tag Name" MaxLength="50"
                          Style="width: 200px;" />
            <MudTextField @bind-Value="_newTagDescription" Label="Description (optional)"
                          MaxLength="2000" Style="width: 300px;" />
            <MudButton OnClick="CreateTagAsync" Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="_loading || string.IsNullOrWhiteSpace(_newTagName)">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="mr-1" />
                Add
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Class="d-flex justify-center ma-8" />
    }
    else if (_tags.Count == 0)
    {
        <MudPaper Class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.LabelOff" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="mt-2">No tags yet</MudText>
        </MudPaper>
    }
    else
    {
        <MudDataGrid Items="_tags" Hover="true" Dense="true" Striped="true" EditMode="DataGridEditMode.Inline">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Name" IsEditable="false" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <TemplateColumn Title="Actions" Sortable="false" Filterable="false" IsEditable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="() => StartEdit(context.Item)" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    }

    <MudDialog @bind-Visible="_editDialogVisible" Options="_dialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">Edit Tag: @_editingTag?.Name</MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="_editDescription" Label="Description" MaxLength="2000" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => _editDialogVisible = false">Cancel</MudButton>
            <MudButton OnClick="SaveTagAsync" Color="Color.Primary" Disabled="_savingTag">Save</MudButton>
        </DialogActions>
    </MudDialog>
</MudContainer>

@code {
    private List<TagDto> _tags = new();
    private bool _loading = true;
    private string _newTagName = "";
    private string? _newTagDescription;

    private bool _editDialogVisible;
    private TagDto? _editingTag;
    private string? _editDescription;
    private bool _savingTag;
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadTags();
    }

    private async Task LoadTags()
    {
        _loading = true;
        try
        {
            _tags = await TagService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        _loading = false;
    }

    private async Task CreateTagAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTagName)) return;

        try
        {
            await TagService.CreateAsync(new CreateTagRequest(_newTagName.Trim(), _newTagDescription));
            _newTagName = "";
            _newTagDescription = "";
            Snackbar.Add("Tag created", Severity.Success);
            await LoadTags();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void StartEdit(TagDto tag)
    {
        _editingTag = tag;
        _editDescription = tag.Description;
        _editDialogVisible = true;
    }

    private async Task SaveTagAsync()
    {
        if (_editingTag is null) return;

        _savingTag = true;
        try
        {
            await TagService.UpdateAsync(_editingTag.Name, new UpdateTagRequest(_editDescription));
            _editDialogVisible = false;
            Snackbar.Add("Tag updated", Severity.Success);
            await LoadTags();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingTag = false;
        }
    }
}
