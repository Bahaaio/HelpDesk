@page "/register"
@using System.Text.Json
@using HelpDesk.Ui.Components.Layout
@using Microsoft.AspNetCore.WebUtilities
@layout AuthLayout
@rendermode InteractiveServer
@inject AuthState AuthState
@inject AuthService AuthService
@inject NavigationManager Navigation

<MudContainer Class="d-flex justify-center align-center" Style="min-height: 80vh;">
    <MudPaper Class="d-flex flex-column align-center pa-6" Style="width: 380px;" Elevation="4">
        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" Color="Color.Primary"
                 Class="mb-2"/>
        <MudText Typo="Typo.h5" Class="mb-4">
            @(_isInvite ? "Create Technician Account" : "Create Account")
        </MudText>

        @if (_isInvite)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
                You've been invited to register as a technician.
            </MudAlert>
        }

        <MudTextField @bind-Value="_username" Label="Username" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Person" Class="mb-3" FullWidth="true"/>

        <MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email"
                      Class="mb-3" FullWidth="true"/>

        <MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Key"
                      Class="mb-3" FullWidth="true"/>

        <MudButton OnClick="RegisterAsync" Color="Color.Primary" Variant="Variant.Filled"
                   FullWidth="true" Disabled="_loading" Size="Size.Large">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Register
        </MudButton>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" Dense="true">@_error</MudAlert>
        }

        <MudText Class="mt-4">
            Already have an account?
            <MudLink Href="/login">Sign in</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private string _username = "";
    private string _email = "";
    private string _password = "";
    private bool _loading;
    private string _error = "";
    private string? _code;
    private bool _isInvite;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query)
            .TryGetValue("code", out var code))
        {
            _code = code;
            _isInvite = true;
        }
    }

    private async Task RegisterAsync()
    {
        _loading = true;
        _error = "";
        try
        {
            var resp = await AuthService.RegisterAsync(_username, _email, _password, _code);

            if (!resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                _error = ParseError(body);
                return;
            }

            var loginResp = await AuthService.LoginAsync(_username, _password, false);

            if (!loginResp.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/login", false);
                return;
            }

            await AuthState.CheckAsync();
            Navigation.NavigateTo("/tickets", false);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string ParseError(string body)
    {
        try
        {
            var doc = JsonDocument.Parse(body);

            if (doc.RootElement.TryGetProperty("detail", out var detail))
                return detail.GetString() ?? body;

            if (doc.RootElement.TryGetProperty("errors", out var errors))
            {
                var messages = new List<string>();
                foreach (var prop in errors.EnumerateObject())
                {
                    foreach (var err in prop.Value.EnumerateArray())
                    {
                        messages.Add(err.GetString() ?? "");
                    }
                }

                if (messages.Count > 0)
                    return string.Join("\n", messages);
            }
        }
        catch
        {
        }

        return body;
    }

}
