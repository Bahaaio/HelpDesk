@page "/projects/{ProjectId:int}/join"
@using Workbench.Common.Exceptions
@using Workbench.Components.Layout
@using Workbench.Modules.Projects.Invites.Services
@using Workbench.Modules.Projects.Services
@layout AuthLayout
@rendermode InteractiveServer
@inject IProjectInvitesService InvitesService
@inject IProjectsService ProjectsService
@inject IAuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Join Project - Workbench</PageTitle>

<MudPaper Class="pa-6" Style="width: 400px;">
    @if (_loading)
    {
        <div class="d-flex justify-center">
            <MudProgressCircular Indeterminate="true"/>
        </div>
    }
    else if (_error is not null)
    {
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error"
                 Class="d-flex justify-center mb-4"/>
        <MudText Typo="Typo.h6" Class="text-center mb-2">Could not join project</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default" Class="text-center mb-4">@_error</MudText>
        <MudButton Href="/projects" Variant="Variant.Filled" FullWidth="true">
            Go to Projects
        </MudButton>
    }
    else if (_success)
    {
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success"
                 Class="d-flex justify-center mb-4"/>
        <MudText Typo="Typo.h6" Class="text-center mb-2">
            Joined project <b>@_projectName</b>
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Default" Class="text-center mb-4">
            You are now a member of this project.
        </MudText>
        <MudButton Href="@($"/projects/{ProjectId}")" Variant="Variant.Filled" Color="Color.Primary"
                   FullWidth="true">
            Open Project
        </MudButton>
    }
    else if (!AuthState.IsAuthenticated)
    {
        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Primary"
                 Class="d-flex justify-center mb-4"/>
        <MudText Typo="Typo.h6" Class="text-center mb-2">Sign in required</MudText>
        <MudText Typo="Typo.body2" Color="Color.Default" Class="text-center mb-4">
            You need an account to join this project.
        </MudText>
        <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
            Sign In
        </MudButton>
    }
    else
    {
        <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Size="Size.Large" Color="Color.Primary"
                 Class="d-flex justify-center mb-4"/>
        <MudText Typo="Typo.h6" Class="text-center mb-2">Join project
            <b>@_projectName</b>
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Default" Class="text-center mb-4">
            You've been invited to join this project.
        </MudText>
        <MudButton OnClick="JoinProject" Variant="Variant.Filled" Color="Color.Primary"
                   FullWidth="true" Disabled="_joining">
            @if (_joining)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Join Project
        </MudButton>
    }
</MudPaper>

@code {
    [Parameter] public int ProjectId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    private bool _loading = true;
    private bool _joining;
    private bool _success;
    private string? _error;
    private string _projectName = "project";

    protected override async Task OnInitializedAsync()
    {
        AuthState.Check();

        try
        {
            var project = await ProjectsService.GetById(ProjectId);
            _projectName = project.Name;
        }
        catch
        {
        }

        _loading = false;
    }

    private async Task JoinProject()
    {
        if (string.IsNullOrEmpty(Code)) return;

        _joining = true;
        StateHasChanged();

        try
        {
            await InvitesService.Consume(Code);
            _success = true;
        }
        catch (BadRequestException)
        {
            _error = "This invite is invalid or has expired.";
        }
        catch (ConflictException)
        {
            Navigation.NavigateTo($"/projects/{ProjectId}");
            return;
        }
        catch (Exception)
        {
            _error = "Something went wrong. Please try again.";
        }

        _joining = false;
    }

}
