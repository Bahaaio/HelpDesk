@page "/tickets/{Id:int}"
@rendermode InteractiveServer
@inject TicketService TicketService
@inject VoteService VoteService
@inject CommentService CommentService
@inject TagService TagService
@inject AttachmentService AttachmentService
@inject AssignmentService AssignmentService
@inject AuthState AuthState
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ILogger<TicketDetails> Logger

<PageTitle>Ticket #@Id - HelpDesk</PageTitle>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="d-flex justify-center ma-8" />
}
else if (_ticket is null)
{
    <MudContainer Class="text-center pa-8">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
        <MudText Typo="Typo.h6" Class="mt-2">Ticket not found</MudText>
        <MudButton Href="/tickets" Class="mt-4" Variant="Variant.Outlined">Back to Tickets</MudButton>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/tickets" />
            <MudText Typo="Typo.h4">
                <span style="opacity: 0.5; font-weight: 400;">#@_ticket.Id</span>
                @_ticket.Title
            </MudText>
            <MudSpacer />
            @if (_canEdit)
            {
                <MudTooltip Text="Edit ticket">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Inherit"
                                   OnClick="OpenEditDialog" />
                </MudTooltip>
                <MudTooltip Text="Delete ticket">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   OnClick="() => _deleteDialogVisible = true" />
                </MudTooltip>
            }
            @if (_ticket.Status == Status.Open)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Medium">Open</MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Default" Size="Size.Medium">Closed</MudChip>
            }
        </MudStack>

        <MudPaper Class="pa-4 mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudAvatar Size="Size.Small" Color="Color.Primary">
                    @(_ticket.AuthorUsername?[..1].ToUpper() ?? "?")
                </MudAvatar>
                <MudText Typo="Typo.body2">@_ticket.AuthorUsername</MudText>
                <MudSpacer />
                <MudText Typo="Typo.caption" Color="Color.Default">
                    @_ticket.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                </MudText>
            </MudStack>

            @if (!string.IsNullOrEmpty(_ticket.Description))
            {
                <MudText Typo="Typo.body1" Class="mt-2">@_ticket.Description</MudText>
            }

            <MudStack Row="true" Class="mt-4" AlignItems="AlignItems.Center">
                @foreach (var tag in _ticket.Tags)
                {
                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">@tag</MudChip>
                }
            </MudStack>
        </MudPaper>

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h6">Status</MudText>
            <MudSpacer />
            @if (_canUpdateStatus)
            {
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                    <MudButton OnClick="() => SetStatus(Status.Open)"
                               Color="@(_ticket.Status == Status.Open ? Color.Success : Color.Default)"
                               Disabled="_ticket.Status == Status.Open">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                        Open
                    </MudButton>
                    <MudButton OnClick="() => SetStatus(Status.Closed)"
                               Color="@(_ticket.Status == Status.Closed ? Color.Error : Color.Default)"
                               Disabled="_ticket.Status == Status.Closed">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Class="mr-1" />
                        Close
                    </MudButton>
                </MudButtonGroup>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Default">
                    @(_ticket.Status == Status.Open ? "Open" : "Closed")
                </MudText>
            }
        </MudStack>

        @if (!string.IsNullOrEmpty(_ticket.AssignedToUsername) || AuthState.Role == "Technician")
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h6">Assigned to</MudText>
                <MudSpacer />
                @if (!string.IsNullOrEmpty(_ticket.AssignedToUsername))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudAvatar Size="Size.Small" Color="Color.Primary">
                            @(_ticket.AssignedToUsername?[..1].ToUpper() ?? "?")
                        </MudAvatar>
                        <MudText Typo="Typo.body2">@_ticket.AssignedToUsername</MudText>
                        @if (AuthState.Role == "Technician" && _isAssignedToCurrentUser && _ticket.Status == Status.Open)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                                       OnClick="UnassignAsync" Disabled="_assigning"
                                       StartIcon="@Icons.Material.Filled.PersonRemove">
                                Unassign
                            </MudButton>
                        }
                    </MudStack>
                }
                else
                {
                    @if (AuthState.Role == "Technician" && _ticket.Status == Status.Open)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                   OnClick="AssignAsync" Disabled="_assigning"
                                   StartIcon="@Icons.Material.Filled.PersonAdd">
                            Self Assign
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">Unassigned</MudText>
                    }
                }
            </MudStack>
        }

        <MudDivider Class="mb-4" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">Attachments (@_ticket.Attachments.Count)</MudText>
            <MudSpacer />
            @if (_canEdit)
            {
                <MudFileUpload T="IBrowserFile" FilesChanged="UploadAttachment"
                               Accept=".jpg,.jpeg,.png,.gif,.webp,.log,.pdf,.txt,.csv,.doc,.docx,
                               .xls,.xlsx,.ppt,.pptx,.sql">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.AttachFile">
                            Upload
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
            }
        </MudStack>

        @if (_ticket.Attachments.Count > 0)
        {
            <MudGrid Class="mb-4">
                @foreach (var attachmentId in _ticket.Attachments)
                {
                    <MudItem xs="6" sm="4" md="3">
                        <MudPaper Class="pa-1 relative">
                            <MudLink Href="@AttachmentService.GetImageUrl(attachmentId)" Target="_blank">
                                <img src="@AttachmentService.GetImageUrl(attachmentId)"
                                     alt="Attachment"
                                     style="width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; display: block;"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div style="display: none; width: 100%; aspect-ratio: 1; align-items: center; justify-content: center; flex-direction: column; background: var(--mud-palette-surface); border-radius: 8px; padding: 8px;">
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Large" Color="Color.Default" />
                                    @if (_attachmentNames.TryGetValue(attachmentId, out var fileName))
                                    {
                                        <MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1"
                                                 Style="word-break: break-all; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                            @fileName
                                        </MudText>
                                    }
                                </div>
                            </MudLink>
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                               Color="Color.Error"
                                               Style="position: absolute; top: 4px; right: 4px;"
                                               OnClick="() => DeleteAttachment(attachmentId)" />
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        <MudDivider Class="mb-4" />

        <MudText Typo="Typo.h6" Class="mb-2">Votes</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudTooltip Text="Upvote">
                <MudIconButton Icon="@Icons.Material.Filled.ThumbUp"
                               Color="@(_currentVote == VoteValue.Upvote ? Color.Success : Color.Default)"
                               OnClick="() => VoteAsync(VoteValue.Upvote)"
                               Disabled="!AuthState.IsAuthenticated" />
            </MudTooltip>
            <MudText Typo="Typo.h6" Class="mx-2">@_ticket.VoteScore</MudText>
            <MudTooltip Text="Downvote">
                <MudIconButton Icon="@Icons.Material.Filled.ThumbDown"
                               Color="@(_currentVote == VoteValue.Downvote ? Color.Error : Color.Default)"
                               OnClick="() => VoteAsync(VoteValue.Downvote)"
                               Disabled="!AuthState.IsAuthenticated" />
            </MudTooltip>
        </MudStack>

        <MudDivider Class="mb-4" />

        <MudText Typo="Typo.h6" Class="mb-2">Activity</MudText>

        @if (_timeline.Count == 0)
        {
            <MudPaper Class="pa-4 mb-4 text-center">
                <MudText Typo="Typo.body2" Color="Color.Default">No activity yet</MudText>
            </MudPaper>
        }
        else
        {
            @foreach (var item in _timeline)
            {
                @if (item.Type == TimelineItemType.StatusChange && item.StatusChange is not null)
                {
                    var sc = item.StatusChange;
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2 ml-4"
                              Style="opacity: 0.7;">
                        <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Color="Color.Default" />
                        <MudText Typo="Typo.body2">
                            <strong>@sc.ChangedByUsername</strong> changed status from
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(sc.FromStatus == Status.Open ? Color.Success : Color.Default)"
                                     Variant="Variant.Outlined"
                                     Style="height: 18px; font-size: 0.7rem; pointer-events: none;">
                                @(sc.FromStatus == Status.Open ? "Open" : "Closed")
                            </MudChip>
                            to
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(sc.ToStatus == Status.Open ? Color.Success : Color.Default)"
                                     Variant="Variant.Outlined"
                                     Style="height: 18px; font-size: 0.7rem; pointer-events: none;">
                                @(sc.ToStatus == Status.Open ? "Open" : "Closed")
                            </MudChip>
                        </MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Color="Color.Default">
                            @sc.ChangedAt.ToString("MMM dd, yyyy HH:mm")
                        </MudText>
                    </MudStack>
                }
                else if (item.Type == TimelineItemType.Comment && item.Comment is not null)
                {
                    var comment = item.Comment;
                    <MudPaper Class="pa-3 mb-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                            <MudAvatar Size="Size.Small" Color="Color.Primary">
                                @comment.AuthorUsername[..1].ToUpper()
                            </MudAvatar>
                            <MudText Typo="Typo.subtitle2">@comment.AuthorUsername</MudText>
                            <MudSpacer />
                            <MudText Typo="Typo.caption" Color="Color.Default">
                                @comment.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            </MudText>
                            @if (AuthState.Username == comment.AuthorUsername || AuthState.Role == "Technician")
                            {
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="() => DeleteComment(comment.Id)" />
                                </MudTooltip>
                            }
                        </MudStack>
                        <div Class="ml-8" style="line-height: 1.6;">
                            @foreach (var seg in ParseComment(comment.Content))
                            {
                                @if (seg.IsReference && _referencedTickets.TryGetValue(seg.TicketId, out var refTicket))
                                {
                                    <MudLink Href="@($"/tickets/{seg.TicketId}")" Target="_blank"
                                             Style="vertical-align: middle; text-decoration: none;">
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(refTicket.Status == Status.Open ? Color.Success : Color.Default)"
                                                 Variant="Variant.Outlined"
                                                 Style="height: 20px; font-size: 0.7rem; vertical-align: middle; pointer-events: none;">
                                            @(refTicket.Status == Status.Open ? "Open" : "Closed")
                                        </MudChip>
                                        <span style="font-size: 0.875rem; text-decoration: underline;">
                                            #@seg.TicketId
                                        </span>
                                        <span style="font-size: 0.875rem;">
                                            @(refTicket.Title.Length > 30 ? refTicket.Title[..30] + "..." : refTicket.Title)
                                        </span>
                                    </MudLink>
                                }
                                else if (seg.IsReference)
                                {
                                    <span style="font-size: 0.875rem;"><strong>@seg.Text</strong></span>
                                }
                                else
                                {
                                    <span style="font-size: 0.875rem;">@seg.Text</span>
                                }
                            }
                        </div>
                    </MudPaper>
                }
            }
        }

        @if (AuthState.IsAuthenticated)
        {
            <MudPaper Class="pa-4 mt-4">
                <MudTextField @bind-Value="_newComment" Label="Add a comment"
                              Lines="3" MaxLength="2000" />
                <MudButton OnClick="AddCommentAsync" Color="Color.Primary" Variant="Variant.Filled"
                           Class="mt-2" Disabled="string.IsNullOrWhiteSpace(_newComment) || _submittingComment">
                    @if (_submittingComment)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Post Comment
                </MudButton>
            </MudPaper>
        }
    </MudContainer>
}

<MudDialog @bind-Visible="_editDialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Ticket</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_editTitle" Label="Title" Required="true" MaxLength="200"
                      Class="mb-4" FullWidth="true" />
        <MudTextField @bind-Value="_editDescription" Label="Description" Lines="5" MaxLength="2000"
                      Class="mb-4" FullWidth="true" />
        @if (AuthState.Role == "Technician")
        {
            <MudSelect T="string" Label="Tags" MultiSelection="true"
                       SelectedValues="_editSelectedTags" SelectedValuesChanged="OnEditTagsChanged">
                @foreach (var tag in _allTags)
                {
                    <MudSelectItem Value="@tag.Name">@tag.Name</MudSelectItem>
                }
            </MudSelect>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editDialogOpen = false">Cancel</MudButton>
        <MudButton OnClick="SaveEditAsync" Color="Color.Primary" Disabled="_savingEdit">
            @if (_savingEdit)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_deleteDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Delete Ticket</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete <strong>@_ticket?.Title</strong>? This action cannot be undone.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _deleteDialogVisible = false">Cancel</MudButton>
        <MudButton OnClick="DeleteTicketAsync" Color="Color.Error" Disabled="_deleting">
            @if (_deleting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Delete
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int Id { get; set; }

    private TicketDto? _ticket;
    private List<CommentDto> _comments = new();
    private List<StatusChangeDto> _statusChanges = new();
    private List<TimelineItem> _timeline = new();
    private VoteValue? _currentVote;
    private bool _loading = true;
    private string _newComment = "";
    private bool _submittingComment;
    private bool _canUpdateStatus;
    private bool _canEdit;
    private bool _isAssignedToCurrentUser;
    private bool _assigning;

    private bool _editDialogOpen;
    private string _editTitle = "";
    private string? _editDescription;
    private bool _savingEdit;
    private List<TagDto> _allTags = new();
    private HashSet<string> _editSelectedTags = new();
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private bool _deleteDialogVisible;
    private bool _deleting;

    private Dictionary<int, TicketDto> _referencedTickets = new();
    private static readonly System.Text.RegularExpressions.Regex _ticketRefRegex = new(@"#(\d+)", System.Text.RegularExpressions.RegexOptions.Compiled);
    private Dictionary<Guid, string> _attachmentNames = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ticket = await TicketService.GetByIdAsync(Id);
            _comments = await CommentService.GetAllAsync(Id);

            try
            {
                _statusChanges = await TicketService.GetStatusHistoryAsync(Id);
            }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load ticket {TicketId}", Id);
            Snackbar.Add($"Failed to load ticket: {ex.Message}", Severity.Error);
        }

            try
            {
                _currentVote = await VoteService.GetMyVoteAsync(Id);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to load vote for ticket {TicketId}", Id);
            }

            _canUpdateStatus = AuthState.IsAuthenticated
                && (AuthState.Role == "Technician" || AuthState.Username == _ticket?.AuthorUsername);
            _canEdit = AuthState.IsAuthenticated
                && (AuthState.Role == "Technician" || AuthState.Username == _ticket?.AuthorUsername);
            _isAssignedToCurrentUser = AuthState.IsAuthenticated
                && _ticket?.AssignedToUsername == AuthState.Username;

            if (_canEdit && AuthState.Role == "Technician")
            {
                _allTags = await TagService.GetAllAsync();
            }

            await LoadReferencedTickets();
            await LoadAttachmentNames();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load ticket {TicketId}", Id);
        }

        BuildTimeline();
        _loading = false;
    }

    private void OpenEditDialog()
    {
        if (_ticket is null) return;
        _editTitle = _ticket.Title;
        _editDescription = _ticket.Description;
        _editSelectedTags = new HashSet<string>(_ticket.Tags);
        _editDialogOpen = true;
    }

    private void OnEditTagsChanged(IEnumerable<string> values)
    {
        _editSelectedTags = new HashSet<string>(values);
    }

    private async Task SaveEditAsync()
    {
        if (string.IsNullOrWhiteSpace(_editTitle) || _ticket is null) return;

        _savingEdit = true;
        try
        {
            var updated = await TicketService.UpdateAsync(Id, new UpdateTicketRequest
            {
                Title = _editTitle,
                Description = _editDescription
            });
            _ticket = updated;

            if (AuthState.Role == "Technician")
            {
                await TagService.UpdateTicketTagsAsync(Id, _editSelectedTags.ToList());
                var refreshed = await TicketService.GetByIdAsync(Id);
                if (refreshed is not null) _ticket = refreshed;
            }

            _editDialogOpen = false;
            Snackbar.Add("Ticket updated", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingEdit = false;
        }
    }

    private async Task UploadAttachment(IBrowserFile file)
    {
        try
        {
            await AttachmentService.UploadAsync(Id, file);
            var refreshed = await TicketService.GetByIdAsync(Id);
            if (refreshed is not null) _ticket = refreshed;
            Snackbar.Add("Attachment uploaded", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAttachment(Guid attachmentId)
    {
        try
        {
            await AttachmentService.DeleteAsync(Id, attachmentId);
            var refreshed = await TicketService.GetByIdAsync(Id);
            if (refreshed is not null) _ticket = refreshed;
            Snackbar.Add("Attachment deleted", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SetStatus(Status status)
    {
        try
        {
            await TicketService.UpdateStatusAsync(Id, status);
            _ticket = _ticket! with { Status = status };
            Snackbar.Add($"Ticket status changed to {status}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task AssignAsync()
    {
        _assigning = true;
        try
        {
            await AssignmentService.AssignAsync(Id);
            var refreshed = await TicketService.GetByIdAsync(Id);
            if (refreshed is not null) _ticket = refreshed;
            _isAssignedToCurrentUser = _ticket?.AssignedToUsername == AuthState.Username;
            Snackbar.Add("Ticket assigned to you", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _assigning = false;
        }
    }

    private async Task UnassignAsync()
    {
        _assigning = true;
        try
        {
            await AssignmentService.UnassignAsync(Id);
            var refreshed = await TicketService.GetByIdAsync(Id);
            if (refreshed is not null) _ticket = refreshed;
            _isAssignedToCurrentUser = false;
            Snackbar.Add("Ticket unassigned", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _assigning = false;
        }
    }

    private async Task VoteAsync(VoteValue value)
    {
        try
        {
            if (_currentVote == value)
            {
                await VoteService.DeleteVoteAsync(Id);
                _currentVote = null;
            }
            else
            {
                await VoteService.VoteAsync(Id, value);
                _currentVote = value;
            }

            var updated = await TicketService.GetByIdAsync(Id);
            if (updated is not null) _ticket = updated;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newComment)) return;

        _submittingComment = true;
        try
        {
            var comment = await CommentService.CreateAsync(Id, new CreateCommentRequest(_newComment));
            _comments.Add(comment);
            _newComment = "";
            await LoadReferencedTickets();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _submittingComment = false;
        }
    }

    private async Task DeleteComment(int commentId)
    {
        try
        {
            await CommentService.DeleteAsync(Id, commentId);
            _comments.RemoveAll(c => c.Id == commentId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task LoadReferencedTickets()
    {
        var ids = new HashSet<int>();
        foreach (var comment in _comments)
        {
            foreach (System.Text.RegularExpressions.Match m in _ticketRefRegex.Matches(comment.Content))
            {
                if (int.TryParse(m.Groups[1].Value, out var tid) && tid != Id)
                    ids.Add(tid);
            }
        }

        foreach (var tid in ids)
        {
            if (!_referencedTickets.ContainsKey(tid))
            {
                try
                {
                    var t = await TicketService.GetByIdAsync(tid);
                    if (t is not null) _referencedTickets[tid] = t;
                }
                catch { }
            }
        }
    }

    private async Task LoadAttachmentNames()
    {
        if (_ticket is null) return;
        foreach (var aid in _ticket.Attachments)
        {
            if (_attachmentNames.ContainsKey(aid)) continue;
            var name = await AttachmentService.GetFileNameAsync(aid);
            if (name is not null) _attachmentNames[aid] = name;
        }
    }

    private List<CommentSegment> ParseComment(string content)
    {
        var segments = new List<CommentSegment>();
        var lastEnd = 0;
        foreach (System.Text.RegularExpressions.Match m in _ticketRefRegex.Matches(content))
        {
            if (m.Index > lastEnd)
                segments.Add(new CommentSegment(false, content[lastEnd..m.Index], 0));

            if (int.TryParse(m.Groups[1].Value, out var tid))
                segments.Add(new CommentSegment(true, m.Value, tid));

            lastEnd = m.Index + m.Length;
        }

        if (lastEnd < content.Length)
            segments.Add(new CommentSegment(false, content[lastEnd..], 0));

        return segments;
    }

    private record CommentSegment(bool IsReference, string Text, int TicketId);

    private void BuildTimeline()
    {
        _timeline = new List<TimelineItem>();
        foreach (var c in _comments)
            _timeline.Add(new TimelineItem(c.CreatedAt, TimelineItemType.Comment, Comment: c));
        foreach (var s in _statusChanges)
            _timeline.Add(new TimelineItem(s.ChangedAt, TimelineItemType.StatusChange, StatusChange: s));
        _timeline.Sort((a, b) => a.Timestamp.CompareTo(b.Timestamp));
    }

    private record TimelineItem(DateTime Timestamp, TimelineItemType Type, CommentDto? Comment = null, StatusChangeDto? StatusChange = null);
    private enum TimelineItemType { Comment, StatusChange }

    private async Task DeleteTicketAsync()
    {
        _deleting = true;
        try
        {
            await TicketService.DeleteAsync(Id);
            Snackbar.Add("Ticket deleted", Severity.Success);
            Navigation.NavigateTo("/tickets");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _deleting = false;
        }
    }
}
