@using Workbench.ClientServices
@using Workbench.Modules.Issues.Enums
@using Workbench.Modules.Kanban.Dtos
@using Workbench.Modules.Kanban.Dtos.Requests
@using Workbench.Modules.Kanban.Services
@rendermode InteractiveServer
@inject IBoardsService BoardsService
@inject IBoardColumnsService ColumnsService
@inject IBoardCardsService CardsService
@inject IProjectMembershipState ProjectMembership
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="d-flex justify-center ma-8"/>
}
else if (_board is null)
{
    <MudPaper Class="pa-8 text-center">
        <MudText Typo="Typo.h6">Board not found</MudText>
    </MudPaper>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-4 pb-0">
        <MudSpacer/>
        @if (ProjectMembership.IsLead)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddColumnDialog">
                Add Column
            </MudButton>
        }
    </MudStack>

    <MudScrollable Horizontal="true" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3">
            @foreach (var column in _board.Columns.OrderBy(c => c.Position))
            {
                <MudPaper Class="board-column" Elevation="2" Style="width: 300px; min-width: 300px;">
                    <MudStack Class="pa-3" Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small"
                                     Color="@column.Color.ToMudColor()"/>
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@column.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Default">
                                @column.Cards.Count
                            </MudText>
                            <MudSpacer/>
                            @if (ProjectMembership.IsLead)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                               OnClick="() => OpenAddCardDialog(column.Id)"/>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="() => ConfirmDeleteColumn(column)"/>
                            }
                        </MudStack>

                        @if (!string.IsNullOrEmpty(column.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@column.Description</MudText>
                        }

                        <MudStack Spacing="2" Class="board-cards">
                            @foreach (var card in column.Cards.OrderBy(c => c.Position))
                            {
                                <MudPaper Class="board-card pa-3" Elevation="1"
                                          Style="cursor: grab;">
                                    <MudStack Spacing="1">
                                        <MudLink Href="@($"/projects/{ProjectId}/issues/{card.IssueId}")">
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                                @card.IssueTitle
                                            </MudText>
                                        </MudLink>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudText Typo="Typo.caption" Color="Color.Default">
                                                #@card.IssueId
                                            </MudText>
                                            @if (card.IssueStatus == Status.Open)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Open</MudChip>
                                            }
                                            else if (card.IssueStatus == Status.InProgress)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">In Progress</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default">Closed</MudChip>
                                            }
                                        </MudStack>
                                        @if (ProjectMembership.IsLead)
                                        {
                                            <MudStack Row="true" Spacing="0" Justify="Justify.FlexEnd">
                                                @if (column.Cards.IndexOf(card) > 0)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                                                   Size="Size.Small"
                                                                   OnClick="() => MoveCardUp(card, column)"/>
                                                }
                                                @if (column.Cards.IndexOf(card) < column.Cards.Count - 1)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                                                   Size="Size.Small"
                                                                   OnClick="() => MoveCardDown(card, column)"/>
                                                }
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                               Color="Color.Error"
                                                               OnClick="() => DeleteCard(card)"/>
                                            </MudStack>
                                        }
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    </MudScrollable>
}

@* Add Column Dialog *@
<MudDialog @bind-Visible="_addColumnDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Add Column</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newColumnName" Label="Name" Required="true" MaxLength="100"
                      FullWidth="true" Class="mb-4"/>
        <MudTextField @bind-Value="_newColumnDescription" Label="Description" Lines="2" MaxLength="512"
                      FullWidth="true" Class="mb-4"/>
        <ColorPicker @bind-Value="_newColumnColor" Label="Color"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _addColumnDialogVisible = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="AddColumn" Disabled="_saving">Add</MudButton>
    </DialogActions>
</MudDialog>

@* Add Card Dialog *@
<IssuePickerDialog ProjectId="ProjectId"
                   ExcludeIssueIds="@_boardIssueIds"
                   Title="Add Issue to Board"
                   @bind-Visible="_addCardDialogVisible"
                   IssueSelected="OnIssueSelected"/>

@* Delete Column Confirmation *@
<MudDialog @bind-Visible="_deleteColumnDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Delete Column</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete column <strong>@_columnToDelete?.Name</strong>?</MudText>
        @if (_columnToDelete?.Cards.Count > 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">
                This column has @_columnToDelete.Cards.Count card(s) that will be removed.
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _deleteColumnDialogVisible = false">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="DeleteColumn" Disabled="_saving">Delete</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .board-column {
        border-radius: 8px;
        background: var(--mud-palette-surface);
    }

    .board-cards {
        min-height: 40px;
    }

    .board-card {
        border-radius: 6px;
        transition: box-shadow 0.2s;
    }

    .board-card:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }
</style>

@code {
    [Parameter] public int ProjectId { get; set; }

    private BoardDto? _board;
    private bool _loading = true;
    private bool _saving;

    private bool _addColumnDialogVisible;
    private string _newColumnName = "";
    private string? _newColumnDescription;
    private Common.Enums.Color _newColumnColor = Common.Enums.Color.Blue;

    private bool _addCardDialogVisible;
    private int _addCardColumnId;
    private HashSet<int> _boardIssueIds => _board?.Columns.SelectMany(c => c.Cards).Select(c => c.IssueId).ToHashSet() ?? new();

    private bool _deleteColumnDialogVisible;
    private ColumnDto? _columnToDelete;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadBoard();
    }

    private async Task LoadBoard()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            _board = await BoardsService.Get(ProjectId);
        }
        catch
        {
        }

        _loading = false;
        StateHasChanged();
    }

    private void OpenAddColumnDialog()
    {
        _newColumnName = "";
        _newColumnDescription = null;
        _newColumnColor = Common.Enums.Color.Blue;
        _addColumnDialogVisible = true;
    }

    private async Task AddColumn()
    {
        _saving = true;
        StateHasChanged();

        try
        {
            await ColumnsService.Add(ProjectId, new CreateColumnRequest
            {
                Name = _newColumnName,
                Description = _newColumnDescription,
                Color = _newColumnColor
            });
            _addColumnDialogVisible = false;
            Snackbar.Add("Column added", Severity.Success);
            await LoadBoard();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to add column: {ex.Message}", Severity.Error);
        }

        _saving = false;
        StateHasChanged();
    }

    private void OpenAddCardDialog(int columnId)
    {
        _addCardColumnId = columnId;
        _addCardDialogVisible = true;
    }

    private async Task OnIssueSelected(int issueId)
    {
        _saving = true;
        StateHasChanged();

        try
        {
            await CardsService.Add(ProjectId, new CreateCardRequest
            {
                IssueId = issueId,
                ColumnId = _addCardColumnId
            });
            Snackbar.Add("Card added", Severity.Success);
            await LoadBoard();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to add card: {ex.Message}", Severity.Error);
        }

        _saving = false;
        StateHasChanged();
    }

    private async Task MoveCardUp(CardDto card, ColumnDto column)
    {
        var cardIds = column.Cards.OrderBy(c => c.Position).Select(c => c.Id).ToList();
        var index = cardIds.IndexOf(card.Id);
        if (index <= 0) return;

        (cardIds[index], cardIds[index - 1]) = (cardIds[index - 1], cardIds[index]);

        try
        {
            await CardsService.Reorder(ProjectId, column.Id, new MoveCardRequest { CardIds = cardIds });
            await LoadBoard();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to reorder card: {ex.Message}", Severity.Error);
        }
    }

    private async Task MoveCardDown(CardDto card, ColumnDto column)
    {
        var cardIds = column.Cards.OrderBy(c => c.Position).Select(c => c.Id).ToList();
        var index = cardIds.IndexOf(card.Id);
        if (index < 0 || index >= cardIds.Count - 1) return;

        (cardIds[index], cardIds[index + 1]) = (cardIds[index + 1], cardIds[index]);

        try
        {
            await CardsService.Reorder(ProjectId, column.Id, new MoveCardRequest { CardIds = cardIds });
            await LoadBoard();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to reorder card: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteCard(CardDto card)
    {
        try
        {
            await CardsService.Delete(ProjectId, card.Id);
            Snackbar.Add("Card removed", Severity.Success);
            await LoadBoard();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete card: {ex.Message}", Severity.Error);
        }
    }

    private void ConfirmDeleteColumn(ColumnDto column)
    {
        _columnToDelete = column;
        _deleteColumnDialogVisible = true;
    }

    private async Task DeleteColumn()
    {
        if (_columnToDelete is null) return;

        _saving = true;
        StateHasChanged();

        try
        {
            await ColumnsService.Delete(ProjectId, _columnToDelete.Id);
            _deleteColumnDialogVisible = false;
            Snackbar.Add("Column deleted", Severity.Success);
            await LoadBoard();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete column: {ex.Message}", Severity.Error);
        }

        _saving = false;
        StateHasChanged();
    }
}
