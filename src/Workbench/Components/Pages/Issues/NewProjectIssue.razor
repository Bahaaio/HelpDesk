@page "/projects/{ProjectId:int}/issues/new"
@using Workbench.ClientServices
@using Workbench.Components.Shared.Components
@using Workbench.Modules.Issues.Options
@using Workbench.Modules.Issues.Services
@using Workbench.Modules.Projects.Services
@rendermode InteractiveServer
@inject IProjectMembershipState ProjectMembership
@inject IAuthState AuthState
@inject IProjectsService ProjectsService
@inject NavigationManager Navigation

<PageTitle>New Issue - Workbench</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@($"/projects/{ProjectId}?tab=issues")"/>
        <MudText Typo="Typo.h4">Create Issue</MudText>
    </MudStack>

    <MudPaper Class="pa-6">
        <CreateIssueForm ProjectId="ProjectId" IssueCreated="OnIssueCreated"/>
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public int ProjectId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var project = await ProjectsService.GetById(ProjectId);
            await ProjectMembership.Load(ProjectId);
            ProjectMembership.SetOwner(AuthState.Username == project.OwnerUsername);
        }
        catch
        {
        }
    }

    private void OnIssueCreated(int issueId)
    {
        Navigation.NavigateTo($"/projects/{ProjectId}/issues/{issueId}");
    }
}
